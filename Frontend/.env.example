# Frontend environment. Copy to .env.local for local development. Contains NO secrets (NEXT_PUBLIC_ values are visible in the browser).
# Base URL of the Backend API, no trailing slash.
#   Local:       http://localhost:5000
#   Production:  https://YOUR-BACKEND-DOMAIN   (set in Vercel -> Settings -> Environment Variables)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Public URL of this site (canonical URLs / Open Graph).
#   Production:  https://YOUR-APP.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
