# Copy this file to Backend/.env (exact name) and replace the placeholders with YOUR values.
# .env is git-ignored. Never commit it and never paste real credentials into code or README.

PORT=5000
NODE_ENV=development

# MongoDB Atlas -> Connect -> Drivers -> copy the string, then fill in your user, password and a database name.
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Browser origin(s) allowed by CORS, comma-separated, no trailing slash.
# Local: http://localhost:3000   Production: your real Vercel domain, e.g. https://elucidaty.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional
# MONGODB_DB_NAME=elucidaty
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
